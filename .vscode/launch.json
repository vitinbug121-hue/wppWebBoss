{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: AppColetorPro",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Agendamento por ID",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--agendamento",
        "COLOQUE_O_ID_DA_TAREFA_AQUI"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
